{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/business-analytics-simulation-casebook/metric-contracts.schema.json",
  "title": "Metric Contracts",
  "type": "object",
  "required": ["schema_version", "synthetic", "metrics"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "synthetic": {"const": true},
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["metric_id", "case_id", "grain", "numerator", "denominator", "unit", "decision_use"],
        "properties": {
          "metric_id": {"type": "string", "minLength": 1},
          "case_id": {"type": "string", "minLength": 1},
          "grain": {"type": "string", "minLength": 1},
          "numerator": {"type": "string", "minLength": 1},
          "denominator": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1},
          "decision_use": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
